# Copy this file to .build-config.env in the repository root and edit it.

# SSH destination for the Steam Deck in Desktop Mode.
DECK_HOST="deck@192.168.1.100"

# Fedora-side workspace. This is intentionally outside the Git checkout.
BUILD_WORK_ROOT="$HOME/steamos-waydroid-personal"

# Local bundle identifier installed under the deck user's home directory.
BUNDLE_VERSION="personal-1"

# Fedora-side directory containing archives the Deck can pull. The default is
# under BUILD_WORK_ROOT and normally does not need changing.
PUBLISH_ROOT="$BUILD_WORK_ROOT/publish"
