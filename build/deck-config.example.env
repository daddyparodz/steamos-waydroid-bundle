# Copy this file to .deck-config.env in the repository root on the Steam Deck.

# The Deck pulls immutable build artifacts from this location. For a private
# GitHub repository, install gh under the deck user's PATH, run `gh auth login`
# on the Deck, and use the three GitHub settings below.
ARTIFACT_SOURCE="github-release"
GITHUB_REPOSITORY="pjohno/steamos-waydroid-personal"
GITHUB_RELEASE_TAG="private-bundles"

# To pull directly from the Fedora build machine instead, comment the three
# settings above and use its SSH Host alias plus the publish path:
# ARTIFACT_SOURCE="fedora-build:steamos-waydroid-personal/publish"

# A public https:// artifact directory is also supported without gh.

# "auto" selects the preferred published bundle whose exact SteamOS target
# fingerprint matches this Deck. A specific version may be supplied for manual
# bundle management; target verification still applies before activation.
BUNDLE_VERSION="auto"
