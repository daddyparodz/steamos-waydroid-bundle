#!/bin/bash

BOOT_TIMEOUT_SECONDS=90

SHARED_FOLDER_LIB=/usr/lib/steamos-waydroid/shared-folder.sh
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
if [ ! -r "$SHARED_FOLDER_LIB" ] &&
	[ -r "$SCRIPT_DIR/../../libexec/steamos-waydroid/shared-folder.sh" ]; then
	SHARED_FOLDER_LIB="$SCRIPT_DIR/../../libexec/steamos-waydroid/shared-folder.sh"
fi
if [ -r "$SHARED_FOLDER_LIB" ]; then
	# shellcheck source=../../libexec/steamos-waydroid/shared-folder.sh
	source "$SHARED_FOLDER_LIB"
	if ! USER_HOME="$(waydroid_user_home)"; then
		exit 1
	fi
else
	printf 'error: Waydroid shared-folder helper is missing: %s\n' "$SHARED_FOLDER_LIB" >&2
	exit 1
fi

resolve_waydroid_profile "$@" || exit $?
export XDG_DATA_HOME=$WAYDROID_XDG_DATA_HOME
PROFILE_HOME=${WAYDROID_IMAGE%/*}

start_android_16_controller_hotplug() {
	local android_sdk count helper helper_pid pid_file

	android_sdk="$(waydroid shell -- getprop ro.build.version.sdk 2>/dev/null)" || return 0
	android_sdk="${android_sdk//$'\r'/}"
	[ "$android_sdk" = "36" ] || return 0

	helper=/usr/bin/waydroid-controller-hotplug
	[ -x "$helper" ] || return 0
	pid_file="/run/steamos-waydroid/controller-hotplug-$WAYDROID_PROFILE/pid"

	"$helper" --stop "$WAYDROID_PROFILE" || true
	"$helper" "$WAYDROID_PROFILE" &
	helper_pid=$!

	# Do not return until the helper owns its PID file (or has exited), so the
	# shutdown path cannot race a helper that has not initialized yet.
	for ((count = 0; count < 30; count++)); do
		[ -r "$pid_file" ] && [ "$(cat "$pid_file" 2>/dev/null)" = "$helper_pid" ] && return 0
		kill -0 "$helper_pid" 2>/dev/null || return 0
		sleep 0.1
	done
	return 0
}

announce_virtual_game_controllers() {
	local event_uevent input_dir

	# Only virtual devices exposing a Linux joystick node are controllers.
	# Announcing every virtual input device also passes Wayland's synthetic
	# mouse/touch devices into Android, duplicating Waydroid's compositor input
	# stream and giving the two streams incompatible pointer coordinates.
	for event_uevent in /sys/devices/virtual/input/input*/event*/uevent; do
		[ -e "$event_uevent" ] || continue
		input_dir=$(dirname "$(dirname "$event_uevent")")
		compgen -G "$input_dir/js*" >/dev/null || continue
		printf 'add\n' >"$event_uevent"
	done
}

# capture the existing kernel.pid_max value
sysctl -a 2>/dev/null | grep kernel.pid_max | cut -d " " -f 3 >"$PROFILE_HOME/orig_kernel.pid_max"

# set the kernel.pid_max to 65535
sudo sysctl -w kernel.pid_max=65535

# Wait for Android user 0 to be fully running and unlocked. Binding before this
# point leaves /data/media/0 populated but Android's /storage/emulated/0 view
# stale for the lifetime of the session.
mount_waydroid_share_when_ready "$USER_HOME" "$BOOT_TIMEOUT_SECONDS" 2 "$WAYDROID_PROFILE" || exit $?

# These are the commands to execute once Android boot and shared storage are ready.

# Steam/virtual controllers work in Waydroid without duplicating host pointer
# and touchscreen devices already forwarded by the Wayland backend.
announce_virtual_game_controllers
start_android_16_controller_hotplug

# The stock Android TV launcher exposes Home/Discover/Apps as remote-focus
# controls rather than clickable views. Pre-authorize the bundle's private ADB
# key so the user-session touch bridge can translate only those controls while
# forwarding all normal launcher input unchanged.
if waydroid shell -- getprop ro.build.characteristics 2>/dev/null | grep -qw tv &&
	[ -r "$PROFILE_HOME/adbkey.pub" ]; then
	ADB_PUBLIC_KEY=$(cat "$PROFILE_HOME/adbkey.pub")
	waydroid shell -- mkdir -p /data/misc/adb
	if ! waydroid shell -- grep -Fqx "$ADB_PUBLIC_KEY" /data/misc/adb/adb_keys 2>/dev/null; then
		ADB_PUBLIC_KEY_BASE64=$(printf '%s\n' "$ADB_PUBLIC_KEY" | base64 -w 0)
		waydroid shell -- sh -c \
			"printf '%s' '$ADB_PUBLIC_KEY_BASE64' | base64 -d >>/data/misc/adb/adb_keys"
		waydroid shell -- chmod 0640 /data/misc/adb/adb_keys
		waydroid shell -- chown system:shell /data/misc/adb/adb_keys
	fi
	waydroid shell -- setprop persist.adb.tcp.port 5555
	waydroid shell -- setprop service.adb.tcp.port 5555
	waydroid shell -- setprop ctl.restart adbd
fi

# Use the same pointer- and touch-capable keyboard on regular Android and TV.
# Keep its exact registered component selected; the expanded class name is not
# accepted by `ime`.
HELIBOARD_APK=$PROFILE_HOME/HeliBoard.apk
if ! waydroid shell -- pm path helium314.keyboard >/dev/null 2>&1 &&
	[ -r "$HELIBOARD_APK" ]; then
	waydroid app install "$HELIBOARD_APK" || exit 1
fi
# A fresh GApps phone image can register the package globally before activating
# it for Android user 0. Make that first-boot transition explicit instead of
# racing the package scanner and falling back to the stock AOSP keyboard.
if ! waydroid shell -- pm path helium314.keyboard >/dev/null 2>&1 &&
	waydroid shell -- pm list packages -u helium314.keyboard 2>/dev/null |
		grep -Fq 'package:helium314.keyboard'; then
	waydroid shell -- cmd package install-existing --user 0 helium314.keyboard || true
fi
if waydroid shell -- pm path helium314.keyboard >/dev/null 2>&1; then
	waydroid shell -- pm enable --user 0 helium314.keyboard || true
	waydroid shell -- ime enable helium314.keyboard/.latin.LatinIME || true
	waydroid shell -- ime set helium314.keyboard/.latin.LatinIME || true
fi

# Let the regular phone/tablet image follow sensor changes and each app's
# requested orientation. Android TV deliberately remains landscape-oriented.
if ! waydroid shell -- getprop ro.build.characteristics 2>/dev/null | grep -qw tv; then
	# Keep standard phone navigation reachable in fullscreen. Some GApps flows
	# leave a global immersive-status policy behind and this image does not
	# select a navigation overlay by default, hiding Home, Recents and the shade.
	waydroid shell -- settings delete global policy_control || true
	waydroid shell -- cmd overlay enable-exclusive --category \
		com.android.internal.systemui.navbar.threebutton --user 0 || true
	waydroid shell -- settings put secure navigation_mode 0 || true

	waydroid shell -- settings put system accelerometer_rotation 1 || true
	waydroid shell -- settings put secure show_rotation_suggestions 1 || true
	waydroid shell -- wm user-rotation free || true
	waydroid shell -- wm fixed-to-user-rotation default || true
	waydroid shell -- wm set-ignore-orientation-request false || true
fi

# disable initial device setup via ADB
waydroid shell pm disable com.google.android.setupwizard

# shizuku root
waydroid shell -- sh -c "if [ -f /storage/emulated/0/Android/data/moe.shizuku.privileged.api/start.sh ]
then
	/storage/emulated/0/Android/data/moe.shizuku.privileged.api/start.sh
	fi"

# mantis gamepad pro
waydroid shell -- sh -c "if [ -f /sdcard/Android/data/app.mantispro.gamepad/files/buddyNew.sh ]
then
	/sdcard/Android/data/app.mantispro.gamepad/files/buddyNew.sh
	fi"

# k2er mapper
waydroid shell -- sh -c "if [ -f /sdcard/Android/data/com.k2tap.master/files/exe/activate.sh ]
then
	/sdcard/Android/data/com.k2tap.master/files/exe/activate.sh
	fi"

# set audio volume to max
waydroid shell -- cmd media_session volume --stream 3 --set 15

# no data permission hack to circumvent the scoped storage permission issue
# Thanks to PrimeOS
waydroid shell -- sh -c "chmod 777 -R /sdcard/Android
chmod 777 -R /sdcard/Android/obb
chmod 777 -R /sdcard/Android/data
chmod 777 -R /data/media/0/Android
chmod 777 -R /data/media/0/Android/obb
chmod 777 -R /data/media/0/Android/data"

# Xbox Wireless Controller spoofing for CoD Mobile to work without 3rd party controller mapping (mantis etc)
if [ -f "$PROFILE_HOME/spoofing/classes.dex" ]; then
	cp "$PROFILE_HOME/spoofing/classes.dex" /var/lib/waydroid/overlay/system/bin/classes.dex
	waydroid shell -- sh -c "export CLASSPATH=/system/bin/classes.dex ; app_process / com.android.commands.hid.Hid" &

else
	rm -f /var/lib/waydroid/overlay/system/bin/classes.dex
fi

exit 0
