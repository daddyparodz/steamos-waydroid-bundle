# The first-run wizard creates .deck-config.env automatically. This file is a
# template for manual setup in the repository root on the Steam Deck.

# The normal first run writes this trusted public default automatically.
ARTIFACT_SOURCE="https://github.com/pjohno/steamos-waydroid-personal/releases/download/private-bundles"

# Advanced alternative: authenticated private GitHub Release. Install gh under
# the deck user's PATH and run `gh auth login` before using these settings:
# ARTIFACT_SOURCE="github-release"
# GITHUB_REPOSITORY="OWNER/REPOSITORY"
# GITHUB_RELEASE_TAG="private-bundles"

# Advanced alternative: a trusted Fedora build machine over SSH/rsync:
# ARTIFACT_SOURCE="SSH_ALIAS:steamos-waydroid-personal/publish"

# Do not select an artifact source you do not trust. Its packages are installed
# into SteamOS with root privileges.

# "auto" selects the preferred published bundle whose exact SteamOS target
# fingerprint matches this Deck. A specific version may be supplied for manual
# bundle management; target verification still applies before activation.
BUNDLE_VERSION="auto"
