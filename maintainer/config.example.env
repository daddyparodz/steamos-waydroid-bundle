# Copy this file to .build-config.env in the repository root and edit it.

# SSH destination for the Steam Deck in Desktop Mode.
DECK_HOST="deck@192.168.1.100"

# Fedora-side workspace. This is intentionally outside the Git checkout.
BUILD_WORK_ROOT="$HOME/steamos-waydroid-personal"

# Bundle identifiers are derived from the captured SteamOS VERSION_ID and
# BUILD_ID. Increment this revision when rebuilding for the same SteamOS build
# after changing build inputs.
BUNDLE_VERSION="auto"
BUNDLE_REVISION="r2"

# Fedora-side directory containing archives the Deck can pull. The default is
# under BUILD_WORK_ROOT and normally does not need changing.
PUBLISH_ROOT="$BUILD_WORK_ROOT/publish"

# GitHub repository and long-lived Release used by
# maintainer/upload-private-bundle-to-github.sh. Authenticate gh on Fedora before
# uploading. Keep the release mutable because its two catalog assets are
# replaced whenever a new target bundle is published.
GITHUB_REPOSITORY="pjohno/steamos-waydroid-personal"
GITHUB_RELEASE_TAG="private-bundles"
