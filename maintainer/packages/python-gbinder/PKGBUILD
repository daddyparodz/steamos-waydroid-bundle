pkgname=python-gbinder
pkgver="${WAYDROID_PYTHON_GBINDER_VERSION:?WAYDROID_PYTHON_GBINDER_VERSION is required}"
pkgrel="${WAYDROID_PYTHON_GBINDER_PKGREL:?WAYDROID_PYTHON_GBINDER_PKGREL is required}"
pkgdesc='Python bindings for libgbinder'
arch=('x86_64')
url='https://github.com/erfanoabdi/gbinder-python'
license=('GPL-3.0-only')
depends=('libgbinder')
makedepends=('cython' 'python-setuptools')
options=('!debug')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/$pkgver.tar.gz")
sha256sums=("${WAYDROID_PYTHON_GBINDER_SHA256:?WAYDROID_PYTHON_GBINDER_SHA256 is required}")

build() {
  cd "gbinder-python-$pkgver"
  python setup.py build --cython
}

package() {
  cd "gbinder-python-$pkgver"
  python setup.py install --root="$pkgdir" --optimize=1 --skip-build
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
