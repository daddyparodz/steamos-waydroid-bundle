pkgname=waydroid
pkgver="${WAYDROID_VERSION:?WAYDROID_VERSION is required}"
pkgrel="${WAYDROID_PKGREL:?WAYDROID_PKGREL is required}"
pkgdesc='Container-based approach to boot a full Android system on Linux'
arch=('any')
url='https://waydro.id/'
license=('GPL-3.0-or-later')
depends=('lxc' 'python-gbinder' 'python-gobject' 'nftables' 'dnsmasq' 'gtk3' 'dbus-python')
options=('!debug')
source=("$pkgname-$pkgver.tar.gz::https://github.com/waydroid/waydroid/archive/refs/tags/$pkgver.tar.gz")
sha256sums=("${WAYDROID_SHA256:?WAYDROID_SHA256 is required}")

package() {
  cd "$pkgname-$pkgver"
  make DESTDIR="$pkgdir" USE_SYSTEMD=1 USE_DBUS_ACTIVATION=1 USE_NFTABLES=0 install
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
